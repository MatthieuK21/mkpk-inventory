# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Postgres (Supabase → Project Settings → Database → Connection string URI)
# Mode "Session" / Direct recommandé pour les migrations
# Obligatoire sur Railway pour appliquer supabase/migrations automatiquement
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-xxx.pooler.supabase.com:5432/postgres

# Optionnel : mot de passe legacy (bootstrap admin)
INVENTORY_PASSWORD=
ADMIN_PASSWORD=

# Railway définit PORT automatiquement
PORT=3000
